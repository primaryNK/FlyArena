# Large or locally generated BANC material
data/cache/
data/io/
data/banc_v888/raw/

# Learned/user state. Tiny fixtures under tests/ remain trackable.
data/training/*.flytrain
data/flies/*.flytrain

# Local packaging output
dist/

# Local development history. Keep these files on disk, but publish only the
# current v0.6.8 source/release surface.
/HOTFIX*.md
/README_V*.md
/benchmarks/
/build_v*.bat
!/build_v068.bat
/run_v*.bat
!/run_v068_learning_arena.bat
!/run_v068_battle_arena.bat
/test_v*.bat
!/test_v068_profile_learning.bat
/reset_v*.bat
/run_cleanup_*.bat
/run_latest_*.bat
/inspect_*.bat
/force_refresh_banc_latest.bat

# Only the current application entry point and current portable test are part
# of the public source release.
/src/sim/*
!/src/sim/v065_learning_main.cpp
/src/maintenance/
/src/tools/
/src/gpu/
/tests/*
!/tests/v065_profile_learning_tests.cpp

# Current public documentation. Older milestone/history files remain local.
/docs/*.md
!/docs/README.md
!/docs/GETTING_STARTED_KO.md
!/docs/GITHUB_RELEASE_KO.md
!/docs/CURRENT_VERSION_MATRIX.md
!/docs/EQUIPMENT_CUSTOMIZATION_SPEC.md
!/docs/FILE_FORMATS.md
!/docs/FLY_CUSTOMIZATION_CONTRACT.md
!/docs/LEARNING_DESIGN.md
!/docs/MICROSOFT_FALSE_POSITIVE_FOLLOWUP_KO.md
!/docs/MODES_AND_UI_SPEC.md
!/docs/PUBLIC_RELEASE_MILESTONE.md
!/docs/V063_ARCHITECTURE.md
!/docs/V063_COMBAT_FEEDBACK_CONTRACT.md
!/docs/V063_RENDERING_CONTRACT.md
!/docs/V068_RELEASE_DATA_SETUP.md

# Publish only the neutral sample profiles, never local/user fly state.
/data/flies/*
!/data/flies/Ruby.flypack
!/data/flies/Azure.flypack

# Exact public helper set; local inspection/refresh helpers stay private.
/tools/*
!/tools/build_banc_io_map.py
!/tools/convert_banc_latest.py
!/tools/package_release.ps1
!/tools/prepare_banc_latest.ps1
!/tools/prepare_v061_io_map.ps1
!/tools/stage_public_source.ps1
